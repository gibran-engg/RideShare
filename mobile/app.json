{
  "expo": {
    "name": "RideShare",
    "slug": "rideshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rideshare.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.rideshare.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RideShare uses your location to set your pickup point and, for drivers, to match nearby ride requests."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RideShare needs your photos to upload your driving licence and vehicle RC.",
          "cameraPermission": "RideShare uses the camera to photograph your driving licence and vehicle RC.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "rideshare",
    "backgroundColor": "#0B0B0B"
  }
}
