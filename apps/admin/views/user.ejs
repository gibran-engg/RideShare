<%- include("partials/head", { wide: true }) %>
<div class="page-head">
    <div>
        <p class="eyebrow"><a href="/users">Users</a> / #<%= user.id %></p>
        <h1><%= user.name || user.email %></h1>
    </div>
    <span class="badge badge-<%= user.status %>"><%= user.status %></span>
</div>

<div class="grid grid-main">
    <div class="stack">
        <div class="filters">
            <% const labels = { rides: "Rides taken", trips: "Trips made", payments: "Payments", activity: "Activity" }; %>
            <% for (const value of tabs) { %>
            <% if (value === "trips" && user.role !== "driver") continue; %>
            <a class="btn btn-sm <%= tab === value ? "" : "btn-ghost" %>" href="/users/<%= user.id %>?tab=<%= value %>"><%= labels[value] %></a>
            <% } %>
        </div>

        <section class="card">
            <h2><%= labels[tab] %></h2>
            <% if (!items.length) { %>
            <p class="empty">Nothing here yet.</p>
            <% } else if (tab === "rides" || tab === "trips") { %>
            <%- include("partials/ride-table", { rides: items, compact: false }) %>
            <% } else if (tab === "payments") { %>
            <%- include("partials/payment-table", { payments: items }) %>
            <% } else { %>
            <ul class="activity-list">
                <% for (const event of items) { const meta = h.metadata(event.metadata); %>
                <li>
                    <div>
                        <strong><%= h.activityLabel(event.type) %></strong>
                        <% if (event.entity_type === "ride") { %> · <a href="/rides/<%= event.entity_id %>">ride #<%= event.entity_id %></a><% } %>
                        <% if (meta.amount != null) { %> · <%= h.money(meta.amount) %><% } %>
                        <% if (meta.provider) { %> · <span class="muted"><%= meta.provider %> via <%= meta.app %></span><% } %>
                        <% if (meta.reason) { %><br><span class="muted small"><%= meta.reason %></span><% } %>
                        <% if (event.ip || event.user_agent) { %><br><span class="muted small mono"><%= event.ip || "" %> <%= (event.user_agent || "").slice(0, 60) %></span><% } %>
                    </div>
                    <span class="muted small nowrap"><%= h.dateTime(event.created_at) %></span>
                </li>
                <% } %>
            </ul>
            <% } %>
            <% if (nextCursor) { %>
            <div class="pager"><a class="btn btn-ghost btn-sm" href="/users/<%= user.id %>?tab=<%= tab %>&cursor=<%= nextCursor %>">Older</a></div>
            <% } %>
        </section>
    </div>

    <aside class="stack">
        <section class="card">
            <h2>Profile</h2>
            <dl class="details">
                <dt>Email</dt><dd><%= user.email %></dd>
                <dt>Phone</dt><dd><%= user.phone || "-" %><% if (user.phone && !user.phone_verified) { %> <span class="badge badge-pending">unverified</span><% } %></dd>
                <dt>Role</dt><dd><%= user.role || (h.isAdmin(user.email) ? "admin" : "-") %></dd>
                <dt>Joined</dt><dd><%= h.dateTime(user.created_at) %></dd>
                <dt>Last sign-in</dt><dd><%= h.dateTime(user.last_login_at) %></dd>
                <% if (driver) { %>
                <dt>Driver</dt><dd><a href="/drivers/<%= user.id %>"><span class="badge badge-<%= driver.verification_status %>"><%= driver.verification_status %></span> documents &amp; vehicle</a></dd>
                <% } %>
            </dl>
        </section>

        <section class="card">
            <h2><%= earnings ? "Driving" : "Riding" %></h2>
            <dl class="details">
                <% if (earnings) { %>
                <dt>Trips</dt><dd><%= earnings.total.trips %></dd>
                <dt>Earned</dt><dd><%= h.money(earnings.total.amount) %></dd>
                <dt>Last 7 days</dt><dd><%= h.money(earnings.week.amount) %> · <%= earnings.week.trips %> trips</dd>
                <% } else { %>
                <dt>Rides</dt><dd><%= riderSummary.rides %></dd>
                <dt>Completed</dt><dd><%= riderSummary.completed %></dd>
                <dt>Cancelled</dt><dd><%= riderSummary.cancelled %></dd>
                <dt>Spent</dt><dd><%= h.money(riderSummary.spent) %></dd>
                <% } %>
            </dl>
        </section>

        <% if (user.id !== currentUser.id) { %>
        <section class="card">
            <form method="post" action="/users/<%= user.id %>/status" data-confirm="<%= user.status === "active" ? "Suspend " + (user.name || user.email) + "? They will be signed out." : "Reinstate " + (user.name || user.email) + "?" %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="back" value="user">
                <input type="hidden" name="status" value="<%= user.status === "active" ? "suspended" : "active" %>">
                <button class="btn btn-block <%= user.status === "active" ? "btn-danger" : "" %>" type="submit"><%= user.status === "active" ? "Suspend user" : "Reinstate user" %></button>
            </form>
        </section>
        <% } %>
    </aside>
</div>
<%- include("partials/foot") %>
