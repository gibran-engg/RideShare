<%- include("partials/head", { wide: true }) %>
<div class="page-head"><h1>Rides</h1></div>

<div class="filters">
    <a class="btn btn-sm <%= status === "" ? "" : "btn-ghost" %>" href="/rides">All</a>
    <% for (const value of statuses) { %>
    <a class="btn btn-sm <%= status === value ? "" : "btn-ghost" %>" href="/rides?status=<%= value %>"><%= h.statusLabel(value) %></a>
    <% } %>
</div>

<section class="card">
    <% if (!rides.length) { %>
    <p class="empty">No rides found.</p>
    <% } else { %>
    <%- include("partials/ride-table", { rides, compact: false }) %>
    <% } %>
    <% if (nextCursor) { %>
    <div class="pager"><a class="btn btn-ghost btn-sm" href="/rides?<%= status ? "status=" + status + "&" : "" %>cursor=<%= nextCursor %>">Older</a></div>
    <% } %>
</section>
<%- include("partials/foot") %>
