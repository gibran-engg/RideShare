# Copy to .env and fill in. Every value has a development default, so `npm run dev` works without a .env.

NODE_ENV=development

# Required in production: long random strings.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Signs payment gateway callbacks so a forged "paid" is rejected.
PAYMENT_WEBHOOK_SECRET=

# ---- Map (MapTiler) ----
# Free key at https://cloud.maptiler.com (no card). Without it the map falls back to CARTO tiles,
# which show an "API KEY REQUIRED" watermark.
MAPTILER_KEY=
# MAPTILER_STYLE=dataviz-dark

# ---- Web app ----
# Where the web app runs (Vite dev server). Its sign-in goes through <WEB_URL>/web/auth/*.
# WEB_URL=http://localhost:5173

# ---- Payments ----
# Only "mock" (test-mode checkout page) exists for now.
# PAYMENT_PROVIDER=mock

# ---- Reaching the API from your phone ----
# By default the API is announced on this PC's Wi-Fi IP (auto-detected), e.g. http://192.168.1.37:3000.
# DEV_HOST=192.168.1.37
# Google and Apple only redirect to HTTPS, so for real sign-in on a phone run a tunnel
# (e.g. `cloudflared tunnel --url http://localhost:3000`) and set its URL here and in mobile/.env:
# API_URL=https://your-tunnel.trycloudflare.com

# ---- Sign in with Google (OAuth 2.0 / OpenID Connect) ----
# https://console.cloud.google.com/apis/credentials -> Create OAuth client ID -> "Web application".
# Authorised redirect URIs:
#   http://localhost:5173/web/auth/google/callback   (web app; works on localhost, no tunnel)
#   <API_URL>/auth/google/callback          (mobile app, via the API; needs an HTTPS tunnel)
#   http://localhost:3002/auth/google/callback   (Admin app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Sign in with Apple (switched off until these are set) ----
# developer.apple.com -> Identifiers -> Services ID (enable Sign in with Apple, return URL <API_URL>/auth/apple/callback),
# and Keys -> a key with Sign in with Apple enabled (download the .p8 once).
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Either the path to the .p8 file or its contents (newlines as \n).
APPLE_PRIVATE_KEY_PATH=
APPLE_PRIVATE_KEY=

# Local dev OAuth provider (always off when NODE_ENV=production).
MOCK_OAUTH_ENABLED=true

# Deep links the API may send the app back to after sign-in.
# APP_REDIRECT_PREFIXES=rideshare://,exp://

# Comma-separated emails allowed into the Admin app.
ADMIN_EMAILS=admin@example.test

# ---- Ports ----
API_PORT=3000
ADMIN_APP_PORT=3002
MOCK_OAUTH_PORT=4000

# ---- Storage ----
DATABASE_PATH=data/rideshare.db
UPLOAD_DIR=data/uploads

# ---- OpenStreetMap services ----
# The public servers are fine for development (light use, cached). Self-host or use a provider in production.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEO_USER_AGENT=RideShare/1.0 (you@example.com)
# Search area bias (lon1,lat1,lon2,lat2) and countries; defaults to Mumbai, India.
# GEO_VIEWBOX=72.75,19.30,73.10,18.88
# GEO_COUNTRY_CODES=in
# OSRM assumes empty roads; durations are multiplied by this for city traffic.
# GEO_TRAFFIC_FACTOR=1.8

SMS_PROVIDER=console
