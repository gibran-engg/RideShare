{
    "name": "rideshare",
    "version": "1.0.0",
    "private": true,
    "description": "Node.js ride-sharing platform: User app (riders + drivers), Admin app and core API with OAuth sign-in.",
    "workspaces": [
        "shared",
        "backend",
        "apps/admin",
        "mock-oauth"
    ],
    "scripts": {
        "dev": "node scripts/dev.ts",
        "start": "node scripts/dev.ts",
        "db:migrate": "node scripts/migrate.ts",
        "db:reset": "node scripts/reset.ts && node scripts/seed.ts",
        "seed": "node scripts/seed.ts",
        "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
        "test:coverage": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-include=\"shared/src/**\" --test-coverage-include=\"backend/src/**\" --test-coverage-lines=80 \"tests/**/*.test.ts\"",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run test:coverage"
    },
    "engines": {
        "node": ">=22.18"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/multer": "^2.3.0",
        "@types/node": "^24.19.2",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/ws": "^8.18.2",
        "eslint": "^10.13.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0"
    },
    "type": "module"
}
